{
  "sourceLanguage" : "en",
  "strings" : {
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero One nutzt Bluetooth, um mit deiner Trezor-Hardware-Wallet zu kommunizieren und Transaktionen sicher zu signieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MoneroOne uses Bluetooth to communicate with your Trezor hardware wallet for secure transaction signing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero One usa Bluetooth para comunicarse con tu cartera de hardware Trezor y firmar transacciones de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero One utilise Bluetooth pour communiquer avec votre portefeuille matériel Trezor afin de signer les transactions en toute sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero One usa il Bluetooth per comunicare con il tuo portafoglio hardware Trezor e firmare le transazioni in modo sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero Oneは、トランザクションに安全に署名するため、BluetoothでTrezorハードウェアウォレットと通信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero One은 Trezor 하드웨어 지갑과 통신하여 거래에 안전하게 서명하기 위해 Bluetooth를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero One gebruikt Bluetooth om met je Trezor-hardwareportemonnee te communiceren, zodat je transacties veilig kunt ondertekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero One używa Bluetooth do komunikacji z portfelem sprzętowym Trezor, aby bezpiecznie podpisywać transakcje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Monero One usa o Bluetooth para se comunicar com sua carteira de hardware Trezor e assinar transações com segurança."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero One folosește Bluetooth pentru a comunica cu portofelul hardware Trezor și pentru a semna tranzacțiile în siguranță."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero One использует Bluetooth для связи с аппаратным кошельком Trezor, чтобы безопасно подписывать транзакции."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero One, işlemleri güvenli bir şekilde imzalamak için Trezor donanım cüzdanınızla Bluetooth üzerinden iletişim kurar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero One використовує Bluetooth для зв’язку з апаратним гаманцем Trezor, щоб безпечно підписувати транзакції."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero One 使用蓝牙与你的 Trezor 硬件钱包通信，以安全地签署交易。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero One 使用藍牙與你的 Trezor 硬體錢包通訊，以安全地簽署交易。"
          }
        }
      }
    },
