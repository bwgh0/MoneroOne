    "Warning: Anyone with this phrase can access your funds! Clipboard clears in 5 min." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung: Wer diese Phrase hat, hat Zugriff auf dein Guthaben! Die Zwischenablage wird nach 5 Min. geleert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advertencia: ¡cualquiera con esta frase puede acceder a tus fondos! El portapapeles se borra en 5 min."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attention : toute personne disposant de cette phrase peut accéder à vos fonds ! Le presse-papiers sera vidé dans 5 min."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attenzione: chiunque abbia questa frase può accedere ai tuoi fondi! Gli appunti si svuotano tra 5 min."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：このフレーズを知っている人は誰でも資金にアクセスできます。クリップボードは5分後に消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고: 이 문구를 가진 사람은 누구나 자금에 접근할 수 있습니다! 클립보드는 5분 후에 지워집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuwing: iedereen met deze zin heeft toegang tot je tegoed! Het klembord wordt over 5 min gewist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga: każdy, kto ma tę frazę, ma dostęp do środków! Schowek zostanie wyczyszczony za 5 min."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: qualquer pessoa com esta frase pode acessar seus fundos! A área de transferência será limpa em 5 min."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertisment: oricine are această frază îți poate accesa fondurile! Clipboardul se golește în 5 min."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внимание: любой, у кого есть эта фраза, получит доступ к вашим средствам! Буфер обмена очистится через 5 мин."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarı: Bu ifadeye sahip olan herkes fonlarınıza erişebilir! Pano 5 dk. içinde temizlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увага: будь-хто з цією фразою має доступ до ваших коштів! Буфер обміну буде очищено через 5 хв."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：任何拥有此助记词的人都能动用你的资金！剪贴板将在 5 分钟后清除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：任何擁有此助記詞的人都能動用你的資金！剪貼板將在 5 分鐘後清除。"
          }
        }
      }
    },
    "Watch-only — balances and transactions, no sending." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ansehen – Guthaben und Transaktionen, kein Senden."
