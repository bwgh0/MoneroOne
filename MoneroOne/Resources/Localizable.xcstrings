    "Location access is restricted on this device. Check your device settings or parental controls." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff ist auf diesem Gerät eingeschränkt. Prüfe deine Geräteeinstellungen oder die Bildschirmzeit-Beschränkungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación está restringido en este dispositivo. Revisa la configuración del dispositivo o los controles parentales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la position est restreint sur cet appareil. Vérifiez les réglages de l’appareil ou le contrôle parental."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla posizione è limitato su questo dispositivo. Controlla le impostazioni del dispositivo o i controlli parentali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでは位置情報へのアクセスが制限されています。デバイスの設定またはペアレンタルコントロールを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 위치 접근이 제한되어 있습니다. 기기 설정이나 자녀 보호 기능을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatietoegang is beperkt op dit apparaat. Controleer je apparaatinstellingen of het ouderlijk toezicht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do lokalizacji jest ograniczony na tym urządzeniu. Sprawdź ustawienia urządzenia lub kontrolę rodzicielską."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização está restrito neste dispositivo. Verifique os ajustes do dispositivo ou os controles parentais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesul la localizare este restricționat pe acest dispozitiv. Verifică configurările dispozitivului sau controlul parental."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к геопозиции на этом устройстве ограничен. Проверьте настройки устройства или родительский контроль."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıtta konum erişimi kısıtlı. Aygıt ayarlarınızı veya ebeveyn denetimlerini kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до локації на цьому пристрої обмежено. Перевірте параметри пристрою або батьківський контроль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上的位置访问受到限制。请检查设备设置或家长控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置上的位置取用受到限制。請檢查裝置設定或分級保護控制。"
          }
        }
      }
    },
    "Location access was denied. Go to Settings > Location and enable location access, then select \"Always\"." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff wurde verweigert. Öffne Einstellungen > Standort, aktiviere den Zugriff und wähle „Immer“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó el acceso a la ubicación. Ve a Configuración > Ubicación, activa el acceso a la ubicación y selecciona “Siempre”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la position a été refusé. Accédez à Réglages > Position, autorisez l’accès à la position, puis sélectionnez « Toujours »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla posizione è stato negato. Vai in Impostazioni > Posizione, consenti l’accesso alla posizione e scegli “Sempre”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報へのアクセスが拒否されました。「設定」>「位置情報」でアクセスを有効にし、「常に」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 접근이 거부되었습니다. 설정 > 위치로 이동하여 위치 접근을 활성화한 다음 ‘항상’을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatietoegang is geweigerd. Ga naar Instellingen > Locatie, schakel locatietoegang in en kies ‘Altijd’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmówiono dostępu do lokalizacji. Otwórz Ustawienia > Lokalizacja, włącz dostęp do lokalizacji i wybierz „Zawsze”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização foi negado. Acesse Ajustes > Localização, ative o acesso à localização e selecione “Sempre”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesul la localizare a fost refuzat. Accesează Configurări > Localizare, activează accesul la localizare, apoi selectează „Întotdeauna”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к геопозиции запрещён. Откройте «Настройки» > «Геопозиция», включите доступ и выберите «Всегда»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum erişimi reddedildi. Ayarlar > Konum bölümüne gidip konum erişimini açın, ardından “Her Zaman” seçeneğini belirleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до локації заборонено. Відкрийте Параметри > Локація, дозвольте доступ до локації й виберіть «Завжди»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置访问已被拒绝。请前往“设置”>“位置”，开启位置访问，然后选择“始终”。"
