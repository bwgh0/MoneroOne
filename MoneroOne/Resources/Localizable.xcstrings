    "Connects your hardware wallet briefly to update the list of outgoing transactions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindet kurz deine Hardware-Wallet, um die Liste ausgehender Transaktionen zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta brevemente tu cartera de hardware para actualizar la lista de transacciones salientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte brièvement votre portefeuille matériel pour mettre à jour la liste des transactions sortantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega brevemente il portafoglio hardware per aggiornare l’elenco delle transazioni in uscita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハードウェアウォレットに一時的に接続して、送金トランザクションのリストを更新します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하드웨어 지갑에 잠시 연결하여 보낸 거래 목록을 업데이트합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindt je hardwareportemonnee even om de lijst met uitgaande transacties bij te werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łączy na chwilę portfel sprzętowy, aby zaktualizować listę transakcji wychodzących."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta brevemente sua carteira de hardware para atualizar a lista de transações enviadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectează pentru scurt timp portofelul hardware ca să actualizeze lista tranzacțiilor trimise."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
