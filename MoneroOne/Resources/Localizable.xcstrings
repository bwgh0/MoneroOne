    },
    "The private view key reveals every incoming transaction. Share it only with people you trust to watch your balance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der private View-Key zeigt jede eingehende Transaktion. Teile ihn nur mit Personen, denen du den Blick auf dein Guthaben anvertraust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de vista privada revela todas las transacciones entrantes. Compártela solo con personas en quienes confíes para ver tu saldo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé d’audit privée révèle toutes les transactions entrantes. Ne la partagez qu’avec des personnes à qui vous confiez le suivi de votre solde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave di visualizzazione privata rivela ogni transazione in entrata. Condividila solo con persone fidate a cui vuoi mostrare il tuo saldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "秘密ビューキーがあれば、受け取ったすべてのトランザクションを確認できます。残高の閲覧を任せられる信頼できる相手とだけ共有してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비공개 보기 키는 들어오는 모든 거래를 드러냅니다. 잔액을 보여 줘도 될 만큼 신뢰하는 사람과만 공유하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geheime alleen-lezen sleutel toont elke inkomende transactie. Deel hem alleen met mensen die je vertrouwt om je saldo te volgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prywatny klucz podglądu ujawnia każdą przychodzącą transakcję. Udostępniaj go tylko osobom, którym ufasz, aby mogły obserwować saldo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave de visualização privada revela todas as transações recebidas. Compartilhe-a apenas com pessoas em quem você confia para acompanhar seu saldo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheia secretă de citire dezvăluie fiecare tranzacție primită. Partajeaz-o doar cu persoane în care ai încredere să-ți urmărească soldul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приватный ключ просмотра раскрывает все входящие транзакции. Передавайте его только тем, кому доверяете наблюдать за вашим балансом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel görüntüleme anahtarı gelen tüm işlemleri açığa çıkarır. Bu anahtarı yalnızca bakiyenizi izlemesine güvendiğiniz kişilerle paylaşın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приватний ключ перегляду розкриває всі вхідні транзакції. Поширюйте його лише серед людей, яким довіряєте стежити за вашим балансом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私有查看密钥会暴露每一笔收到的交易。请只与你信任的人共享，让其查看你的余额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私密檢視金鑰會洩露每一筆收到的交易。請只分享給你信任的人，讓對方查看你的餘額。"
          }
        }
      }
    },
    "The value of Monero can fluctuate significantly. Only use funds you can afford to lose." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wert von Monero kann stark schwanken. Nutze nur Geld, dessen Verlust du verkraften kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valor de Monero puede fluctuar mucho. Usa solo fondos que puedas permitirte perder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valeur du Monero peut fortement fluctuer. N’utilisez que des fonds que vous pouvez vous permettre de perdre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il valore di Monero può oscillare molto. Usa solo fondi che puoi permetterti di perdere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moneroの価値は大きく変動する可能性があります。失っても問題のない資金のみを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero의 가치는 크게 변동할 수 있습니다. 잃어도 괜찮은 자금만 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De waarde van Monero kan sterk schommelen. Gebruik alleen bedragen die je kunt missen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartość Monero może się znacznie wahać. Używaj tylko środków, na których utratę możesz sobie pozwolić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valor do Monero pode oscilar bastante. Use apenas fundos que você pode perder."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valoarea Monero poate fluctua semnificativ. Folosește doar fonduri pe care îți permiți să le pierzi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стоимость Monero может сильно колебаться. Используйте только те средства, потерю которых можете себе позволить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero'nun değeri önemli ölçüde dalgalanabilir. Yalnızca kaybetmeyi göze alabileceğiniz fonları kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вартість Monero може суттєво коливатися. Використовуйте лише ті кошти, втрату яких можете собі дозволити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero 的价值可能大幅波动。请只使用你能承受损失的资金。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero 的價值可能大幅波動。請只使用你能承受損失的資金。"
          }
        }
      }
    },
    "The wallet couldn't load its keys, so no receive address can be shown. Do not send funds to any address from this app until this is resolved. Force-quit and reopen the app; if this persists, restore the wallet from its seed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wallet konnte ihre Schlüssel nicht laden, daher kann keine Empfangsadresse angezeigt werden. Sende kein Guthaben an eine Adresse aus dieser App, bis das behoben ist. Beende die App vollständig und öffne sie erneut; bleibt der Fehler, stelle die Wallet aus ihrem Seed wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartera no pudo cargar sus claves, así que no se puede mostrar ninguna dirección de recepción. No envíes fondos a ninguna dirección de esta app hasta que se resuelva. Fuerza el cierre de la app y vuelve a abrirla; si el problema continúa, restaura la cartera con su frase semilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le portefeuille n’a pas pu charger ses clés : aucune adresse de réception ne peut être affichée. N’envoyez de fonds à aucune adresse de cette app tant que le problème n’est pas résolu. Forcez la fermeture de l’app, puis rouvrez-la ; si le problème persiste, restaurez le portefeuille à partir de sa phrase de récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il portafoglio non è riuscito a caricare le chiavi, quindi non è possibile mostrare un indirizzo di ricezione. Non inviare fondi a nessun indirizzo di questa app finché il problema non è risolto. Chiudi forzatamente l’app e riaprila; se il problema persiste, ripristina il portafoglio dal suo seed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォレットのキーを読み込めなかったため、受取アドレスを表示できません。この問題が解決するまで、このAppに表示されるどのアドレスにも資金を送らないでください。Appを強制終了して開き直してください。問題が続く場合は、シードからウォレットを復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지갑 키를 불러올 수 없어 받기 주소를 표시할 수 없습니다. 이 문제가 해결될 때까지 이 앱에 표시된 어떤 주소로도 자금을 보내지 마세요. 앱을 강제 종료한 후 다시 여세요. 문제가 계속되면 시드로 지갑을 복원하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De portemonnee kon zijn sleutels niet laden, dus er kan geen ontvangstadres worden getoond. Stuur geen geld naar een adres uit deze app totdat dit is opgelost. Stop de app geforceerd en open hem opnieuw. Blijft het probleem, herstel de portemonnee dan met de seedzin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portfel nie mógł wczytać kluczy, więc nie można wyświetlić adresu odbioru. Nie wysyłaj środków na żaden adres z tej aplikacji, dopóki problem nie zostanie rozwiązany. Wymuś zamknięcie aplikacji i otwórz ją ponownie; jeśli problem nie ustąpi, przywróć portfel z frazy seed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carteira não conseguiu carregar as chaves, então nenhum endereço de recebimento pode ser exibido. Não envie fundos para nenhum endereço deste app até que isso seja resolvido. Force o encerramento do app e abra-o novamente; se o problema continuar, restaure a carteira com a semente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portofelul nu și-a putut încărca cheile, așa că nu se poate afișa nicio adresă de primire. Nu trimite fonduri la nicio adresă din această aplicație până nu se rezolvă problema. Închide forțat aplicația și redeschide-o; dacă problema persistă, restaurează portofelul din fraza seed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кошелёк не смог загрузить ключи, поэтому адрес для получения показать нельзя. Не отправляйте средства ни на какой адрес из этого приложения, пока проблема не устранена. Принудительно закройте и снова откройте приложение; если проблема сохранится, восстановите кошелёк по мнемонической фразе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cüzdan anahtarlarını yükleyemediği için alma adresi gösterilemiyor. Sorun çözülene kadar bu uygulamadaki hiçbir adrese fon göndermeyin. Uygulamayı zorla kapatıp yeniden açın; sorun sürerse cüzdanı kurtarma ifadesinden geri yükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гаманцю не вдалося завантажити ключі, тому адресу для отримання показати неможливо. Не надсилайте кошти на жодну адресу з цієї програми, доки проблему не буде усунено. Примусово закрийте й знову відкрийте програму; якщо проблема не зникне, відновіть гаманець з мнемонічної фрази."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钱包无法载入其密钥，因此无法显示收款地址。在问题解决之前，请勿向此 App 显示的任何地址发送资金。请强制退出并重新打开 App；如果问题仍然存在，请用助记词恢复钱包。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錢包無法載入其金鑰，因此無法顯示收款位址。在問題解決之前，請勿將資金傳送到此 App 顯示的任何位址。請強制結束並重新開啟 App；如果問題持續發生，請用助記詞回復錢包。"
          }
        }
      }
    },
