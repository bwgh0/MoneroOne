    "When you're inside a trusted zone, your wallet checks for new transactions at optimal times." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innerhalb einer vertrauenswürdigen Zone prüft deine Wallet zu günstigen Zeitpunkten auf neue Transaktionen."
          }
        },
        "es" : {
          "stringUnit" : {
