        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trezor가 응답하지 않습니다. 잠금이 해제되어 있고 가까이 있는지 확인한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trezor reageert niet. Zorg dat hij ontgrendeld en in de buurt is en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trezor nie odpowiada. Upewnij się, że jest odblokowany i w pobliżu, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Trezor não respondeu. Verifique se ele está desbloqueado e por perto e tente novamente."
