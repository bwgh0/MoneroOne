    "Connection timed out. Try again or switch nodes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitüberschreitung der Verbindung. Versuche es erneut oder wechsle den Node."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se agotó el tiempo de conexión. Inténtalo de nuevo o cambia de nodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai de connexion dépassé. Réessayez ou changez de nœud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connessione scaduta. Riprova o cambia nodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続がタイムアウトしました。もう一度試すか、ノードを切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 시간이 초과되었습니다. 다시 시도하거나 노드를 변경하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time-out bij verbinding. Probeer het opnieuw of kies een andere node."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upłynął limit czasu połączenia. Spróbuj ponownie lub zmień węzeł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão expirou. Tente novamente ou troque de nó."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiunea a expirat. Încearcă din nou sau schimbă nodul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время ожидания подключения истекло. Повторите попытку или выберите другой узел."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı zaman aşımına uğradı. Yeniden deneyin veya başka bir düğüme geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Час очікування з’єднання вичерпано. Повторіть спробу або змініть вузол."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接超时。请重试或切换节点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線逾時。請再試一次或切換節點。"
          }
        }
      }
    },
