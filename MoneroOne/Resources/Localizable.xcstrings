    "Add your home, office, or other safe locations. If your wallet detects activity outside these zones, you'll be notified." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge dein Zuhause, dein Büro oder andere sichere Orte hinzu. Erkennt deine Wallet Aktivität außerhalb dieser Zonen, wirst du benachrichtigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega tu casa, tu oficina u otras ubicaciones seguras. Si tu cartera detecta actividad fuera de estas zonas, recibirás un aviso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez votre domicile, votre bureau ou d’autres lieux sûrs. Si votre portefeuille détecte une activité hors de ces zones, vous recevrez une notification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi casa, ufficio o altri luoghi sicuri. Se il portafoglio rileva attività fuori da queste zone, riceverai una notifica."
          }
        },
        "ja" : {
