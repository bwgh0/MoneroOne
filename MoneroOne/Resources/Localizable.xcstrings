    "XMR price moved implausibly far in one update. Keeping the last known value." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der XMR-Preis hat sich in einem Update unplausibel stark bewegt. Der letzte bekannte Wert bleibt bestehen."
          }
