          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj dom, biuro lub inne bezpieczne miejsca. Jeśli portfel wykryje aktywność poza tymi strefami, otrzymasz powiadomienie."
