    "iOS limits apps to 20 monitored regions. You have %lld trusted locations." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS erlaubt Apps höchstens 20 überwachte Regionen. Vertrauenswürdige Orte: %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS permite supervisar hasta 20 regiones por app. Ubicaciones de confianza: %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS limite les apps à 20 régions surveillées. Lieux de confiance enregistrés : %lld."
          }
        },
        "it" : {
          "stringUnit" : {
