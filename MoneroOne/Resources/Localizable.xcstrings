    },
    "Set this to when you created your wallet to skip scanning older blocks. Useful if sync is taking too long." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze dies auf das Erstelldatum deiner Wallet, um ältere Blöcke zu überspringen. Hilfreich, wenn der Sync zu lange dauert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica cuándo creaste tu cartera para omitir los bloques anteriores. Útil si la sincronización tarda demasiado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez la date de création de votre portefeuille pour ne pas analyser les blocs plus anciens. Utile si la synchronisation prend trop de temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta la data di creazione del portafoglio per saltare la scansione dei blocchi precedenti. Utile se la sincronizzazione richiede troppo tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォレットを作成した日を設定すると、それより古いブロックのスキャンを省略できます。同期に時間がかかりすぎる場合に便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지갑을 만든 날짜로 설정하면 이전 블록 스캔을 건너뜁니다. 동기화가 너무 오래 걸릴 때 유용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel dit in op het moment dat je je portemonnee aanmaakte, zodat oudere blokken niet worden gescand. Handig als synchroniseren te lang duurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw datę utworzenia portfela, aby pominąć skanowanie starszych bloków. Przydatne, gdy synchronizacja trwa zbyt długo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina a data em que você criou sua carteira para pular a varredura de blocos mais antigos. Útil se a sincronização estiver demorando muito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setează data la care ai creat portofelul pentru a omite scanarea blocurilor mai vechi. Util dacă sincronizarea durează prea mult."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите дату создания кошелька, чтобы пропустить сканирование более старых блоков. Полезно, если синхронизация идёт слишком долго."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eski blokları taramayı atlamak için bunu cüzdanınızı oluşturduğunuz tarihe ayarlayın. Eşzamanlama çok uzun sürüyorsa işe yarar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажіть дату створення гаманця, щоб не сканувати старіші блоки. Корисно, якщо синхронізація триває надто довго."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此项设为你创建钱包的时间，即可跳过扫描更早的区块。同步耗时过长时很有用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將此項設為你建立錢包的時間，即可略過掃描較舊的區塊。同步耗時過長時很有用。"
          }
        }
      }
    },
    "Set to when you created your wallet to skip older blocks. Monero produces ~1 block every 2 minutes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze es auf das Erstelldatum deiner Wallet, um ältere Blöcke zu überspringen. Monero erzeugt etwa alle 2 Minuten einen Block."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica cuándo creaste tu cartera para omitir los bloques anteriores. Monero produce ~1 bloque cada 2 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez la date de création de votre portefeuille pour ignorer les blocs plus anciens. Monero produit ~1 bloc toutes les 2 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta la data di creazione del portafoglio per saltare i blocchi precedenti. Monero produce ~1 blocco ogni 2 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォレットを作成した時点に設定すると、それより古いブロックを省略できます。Moneroでは約2分ごとに1ブロックが生成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지갑을 만든 시점으로 설정하면 이전 블록을 건너뜁니다. Monero는 약 2분마다 블록을 1개 생성합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel in op het moment dat je je portemonnee aanmaakte om oudere blokken over te slaan. Monero produceert ~1 blok per 2 minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw datę utworzenia portfela, aby pominąć starsze bloki. Monero tworzy ok. 1 blok co 2 minuty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina a data em que você criou sua carteira para pular blocos mais antigos. O Monero produz ~1 bloco a cada 2 minutos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setează data la care ai creat portofelul pentru a omite blocurile mai vechi. Monero produce ~1 bloc la fiecare 2 minute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите дату создания кошелька, чтобы пропустить старые блоки. Monero создаёт ~1 блок каждые 2 минуты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eski blokları atlamak için cüzdanınızı oluşturduğunuz tarihe ayarlayın. Monero yaklaşık her 2 dakikada 1 blok üretir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажіть дату створення гаманця, щоб пропустити старіші блоки. Monero створює ~1 блок кожні 2 хвилини."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设为你创建钱包的时间，即可跳过更早的区块。Monero 大约每 2 分钟产生 1 个区块。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設為你建立錢包的時間，即可略過較舊的區塊。Monero 大約每 2 分鐘產生 1 個區塊。"
          }
        }
      }
    },
    "Setting an accurate date speeds up scanning. Leave off to scan from genesis (slower)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein genaues Datum beschleunigt den Scan. Lass es aus, um ab dem Genesis-Block zu scannen (langsamer)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fecha precisa acelera el escaneo. Déjalo desactivado para escanear desde el bloque génesis (más lento)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une date précise accélère l’analyse. Laissez désactivé pour analyser depuis le bloc de genèse (plus lent)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una data precisa velocizza la scansione. Lascia disattivato per scansionare dal blocco genesi (più lento)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正確な日付を設定するとスキャンが速くなります。オフのままにすると、ジェネシスブロックからスキャンします（低速）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정확한 날짜를 설정하면 스캔이 빨라집니다. 끄면 제네시스 블록부터 스캔합니다(더 느림)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een juiste datum versnelt het scannen. Laat uit om vanaf het genesisblok te scannen (langzamer)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokładna data przyspiesza skanowanie. Pozostaw wyłączone, aby skanować od pierwszego bloku (wolniej)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definir uma data precisa acelera a varredura. Deixe desativado para escanear desde o bloco gênese (mais lento)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dată exactă accelerează scanarea. Lasă dezactivat pentru a scana de la blocul geneză (mai lent)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точная дата ускоряет сканирование. Оставьте выключенным, чтобы сканировать с первого блока (медленнее)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğru bir tarih ayarlamak taramayı hızlandırır. Başlangıç bloğundan taramak için kapalı bırakın (daha yavaş)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точна дата пришвидшує сканування. Залиште вимкненим, щоб сканувати з першого блоку (повільніше)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置准确的日期可以加快扫描。保持关闭则从创世区块开始扫描（较慢）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定準確的日期可加快掃描。保持關閉則從創世區塊開始掃描（較慢）。"
          }
        }
      }
