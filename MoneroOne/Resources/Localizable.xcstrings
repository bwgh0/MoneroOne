        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa to wszystkie portfele tylko z tego urządzenia. Portfele nadal istnieją w blockchainie i można je odzyskać za pomocą fraz seed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove todas as carteiras apenas deste dispositivo. Suas carteiras continuam existindo na blockchain e podem ser recuperadas com suas frases-semente."
