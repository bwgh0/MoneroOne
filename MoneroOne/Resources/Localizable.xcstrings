    "Define security zones where your wallet stays updated. Requires \"Always\" location permission." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Sicherheitszonen fest, in denen deine Wallet aktuell bleibt. Erfordert die Standortberechtigung „Immer“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define zonas de seguridad donde tu cartera se mantiene actualizada. Requiere el permiso de ubicación “Siempre”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez des zones de sécurité où votre portefeuille reste à jour. Nécessite l’autorisation de localisation « Toujours »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definisci zone di sicurezza in cui il portafoglio resta aggiornato. Richiede l’accesso alla posizione “Sempre”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォレットを最新の状態に保つセキュリティゾーンを設定します。位置情報の許可を「常に」にする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지갑이 최신 상태로 유지되는 보안 구역을 정하세요. ‘항상’ 위치 권한이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel beveiligingszones in waar je portemonnee bijgewerkt blijft. Vereist locatietoestemming ‘Altijd’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Określ strefy bezpieczeństwa, w których portfel pozostaje aktualny. Wymaga dostępu do lokalizacji „Zawsze”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina zonas de segurança onde sua carteira fica atualizada. Requer a permissão de localização “Sempre”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definește zone de securitate în care portofelul rămâne actualizat. Necesită permisiunea de localizare „Întotdeauna”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте зоны безопасности, в которых кошелёк остаётся актуальным. Требуется доступ к геопозиции «Всегда»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cüzdanınızın güncel kaldığı güvenlik bölgeleri tanımlayın. “Her Zaman” konum izni gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Визначте безпечні зони, у яких гаманець залишається оновленим. Потрібен дозвіл на доступ до локації «Завжди»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设定让钱包保持更新的安全区域。需要“始终”位置权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定讓錢包保持更新的安全區域。需要「永遠」位置權限。"
          }
        }
      }
    },
