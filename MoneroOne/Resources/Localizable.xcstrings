    "Unlock your wallet quickly and securely with %@ instead of entering your PIN." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperre deine Wallet schnell und sicher mit %@ statt mit deiner PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea tu cartera de forma rápida y segura con %@ en lugar de ingresar tu PIN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillez votre portefeuille rapidement et en toute sécurité avec %@ au lieu de saisir votre code PIN."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sblocca il portafoglio in modo rapido e sicuro con %@ invece di inserire il PIN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PINを入力する代わりに、%@ですばやく安全にウォレットのロックを解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN을 입력하는 대신 %@로 지갑을 빠르고 안전하게 잠금 해제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontgrendel je portemonnee snel en veilig met %@ in plaats van je PIN in te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odblokowuj portfel szybko i bezpiecznie za pomocą %@ zamiast wprowadzać PIN."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueie sua carteira com rapidez e segurança usando o %@ em vez de digitar seu PIN."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
