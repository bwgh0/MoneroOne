    "Once a Monero transaction is confirmed, it cannot be reversed, canceled, or modified. Always verify addresses before sending." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine bestätigte Monero-Transaktion lässt sich nicht rückgängig machen, stornieren oder ändern. Prüfe Adressen immer vor dem Senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez confirmada, una transacción de Monero no se puede revertir, cancelar ni modificar. Verifica siempre las direcciones antes de enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois confirmée, une transaction Monero ne peut être ni annulée, ni inversée, ni modifiée. Vérifiez toujours les adresses avant d’envoyer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta confermata, una transazione Monero non può essere stornata, annullata o modificata. Verifica sempre gli indirizzi prima di inviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moneroのトランザクションは、承認されると取り消し、キャンセル、変更ができません。送金前に必ずアドレスを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero 거래는 확인되면 되돌리거나 취소하거나 수정할 수 없습니다. 보내기 전에 항상 주소를 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zodra een Monero-transactie is bevestigd, kan deze niet worden teruggedraaid, geannuleerd of gewijzigd. Controleer altijd de adressen voordat je verzendt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potwierdzonej transakcji Monero nie można cofnąć, anulować ani zmienić. Zawsze sprawdzaj adresy przed wysłaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de confirmada, uma transação Monero não pode ser revertida, cancelada nem modificada. Sempre verifique os endereços antes de enviar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odată confirmată, o tranzacție Monero nu poate fi inversată, anulată sau modificată. Verifică întotdeauna adresele înainte de a trimite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтверждённую транзакцию Monero нельзя отозвать, отменить или изменить. Всегда проверяйте адреса перед отправкой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Monero işlemi onaylandıktan sonra geri alınamaz, iptal edilemez veya değiştirilemez. Göndermeden önce adresleri her zaman doğrulayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підтверджену транзакцію Monero неможливо скасувати, повернути чи змінити. Завжди перевіряйте адресу перед надсиланням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero 交易一经确认，便无法撤销、取消或修改。发送前请务必核对地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monero 交易一經確認，就無法撤銷、取消或修改。傳送前請務必核對位址。"
          }
        }
      }
    },
