    "Available balance: %@. Some funds locked until recent transactions confirm." : {
      "comment" : "VoiceOver: spendable balance while some funds are locked; %@ is the amount",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfügbares Guthaben: %@. Ein Teil ist gesperrt, bis neue Transaktionen bestätigt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldo disponible: %@. Parte de los fondos está bloqueada hasta que se confirmen las transacciones recientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solde disponible : %@. Une partie des fonds est verrouillée jusqu’à la confirmation des transactions récentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldo disponibile: %@. Parte dei fondi è bloccata finché le transazioni recenti non vengono confermate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用可能残高：%@。最近のトランザクションが承認されるまで、一部の資金はロックされています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 가능 잔액: %@. 최근 거래가 확인될 때까지 일부 자금이 잠겨 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschikbaar saldo: %@. Een deel is vergrendeld tot recente transacties zijn bevestigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostępne saldo: %@. Część środków jest zablokowana do potwierdzenia ostatnich transakcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldo disponível: %@. Parte dos fundos está bloqueada até as transações recentes serem confirmadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sold disponibil: %@. Unele fonduri sunt blocate până la confirmarea tranzacțiilor recente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступный баланс: %@. Часть средств заблокирована до подтверждения последних транзакций."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanılabilir bakiye: %@. Son işlemler onaylanana kadar bazı fonlar kilitli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступний баланс: %@. Частину коштів заблоковано, доки нові транзакції не буде підтверджено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
