        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este software é fornecido no estado em que se encontra. Embora busquemos segurança e confiabilidade, não podemos garantir que o software esteja livre de erros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
