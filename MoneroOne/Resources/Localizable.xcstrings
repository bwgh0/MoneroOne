    "This helps speed up transaction scanning by skipping blocks before your wallet existed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das beschleunigt den Transaktionsscan, weil Blöcke vor der Erstellung deiner Wallet übersprungen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto acelera el escaneo de transacciones al omitir los bloques anteriores a la creación de tu cartera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela accélère l’analyse des transactions en ignorant les blocs antérieurs à la création de votre portefeuille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocizza la scansione delle transazioni saltando i blocchi precedenti alla creazione del portafoglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォレットが存在する前のブロックを省略することで、トランザクションのスキャンを高速化できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지갑이 생성되기 전의 블록을 건너뛰어 거래 스캔 속도를 높입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit versnelt het scannen van transacties, doordat blokken van vóór je portemonnee worden overgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyspiesza to skanowanie transakcji dzięki pominięciu bloków sprzed utworzenia portfela."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso acelera a varredura de transações ao pular os blocos anteriores à existência da sua carteira."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accelerează scanarea tranzacțiilor prin omiterea blocurilor de dinainte de existența portofelului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
