    "This software is provided as-is. While we strive for security and reliability, we cannot guarantee the software is free of bugs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Software wird ohne Gewähr bereitgestellt. Wir arbeiten an Sicherheit und Zuverlässigkeit, können aber keine Fehlerfreiheit garantieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este software se ofrece tal cual. Aunque nos esforzamos por que sea seguro y confiable, no podemos garantizar que esté libre de errores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce logiciel est fourni tel quel. Nous visons la sécurité et la fiabilité, mais ne pouvons pas garantir qu’il soit exempt de bugs."
