    "Main address links all transactions. Use subaddresses for privacy." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hauptadresse verknüpft alle Transaktionen. Nutze Subadressen für mehr Privatsphäre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección principal vincula todas las transacciones. Usa subdirecciones para tener privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse principale relie toutes vos transactions. Utilisez des sous-adresses pour préserver votre confidentialité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’indirizzo principale collega tutte le transazioni. Usa i sottoindirizzi per la privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メインアドレスではすべてのトランザクションが紐付けられます。プライバシーを守るにはサブアドレスを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 주소는 모든 거래를 연결합니다. 개인정보 보호를 위해 하위 주소를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het hoofdadres koppelt alle transacties. Gebruik subadressen voor privacy."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adres główny łączy wszystkie transakcje. Dla prywatności używaj podadresów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O endereço principal vincula todas as transações. Use subendereços para ter privacidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresa principală leagă toate tranzacțiile. Folosește subadrese pentru confidențialitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основной адрес связывает все транзакции. Для конфиденциальности используйте субадреса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana adres tüm işlemleri birbirine bağlar. Gizlilik için alt adresler kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основна адреса пов’язує всі транзакції. Для приватності використовуйте субадреси."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主地址会关联所有交易。请使用子地址保护隐私。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主要位址會連結所有交易。請使用子位址來保護隱私。"
          }
        }
      }
    },
