            "value" : "Trezor yanıt vermedi. Kilidinin açık ve yakında olduğundan emin olup yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trezor не відповідає. Переконайтеся, що він розблокований і поруч, і повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
