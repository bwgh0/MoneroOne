    "Trezor didn't respond. Make sure it's unlocked and nearby, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Trezor antwortet nicht. Stelle sicher, dass er entsperrt und in der Nähe ist, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Trezor no respondió. Asegúrate de que esté desbloqueado y cerca, e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Trezor n’a pas répondu. Vérifiez qu’il est déverrouillé et à proximité, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Trezor non ha risposto. Assicurati che sia sbloccato e vicino, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trezorが応答しませんでした。ロックが解除されていて近くにあることを確認してから、もう一度お試しください。"
