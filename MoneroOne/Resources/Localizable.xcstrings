        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不明なエラーが発生しました。シードフレーズを確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알 수 없는 오류가 발생했습니다. 시드 문구를 확인하고 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een onbekende fout opgetreden. Controleer je seedzin en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wystąpił nieznany błąd. Sprawdź frazę seed i spróbuj ponownie."
