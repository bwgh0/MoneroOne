    "This protects you from wallet activity on untrusted networks like public Wi-Fi or unknown locations." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das schützt dich vor Wallet-Aktivität in nicht vertrauenswürdigen Netzen wie öffentlichem WLAN oder an unbekannten Orten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto te protege de actividad de la cartera en redes no confiables, como redes Wi-Fi públicas o ubicaciones desconocidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela vous protège de l’activité du portefeuille sur des réseaux non fiables, comme un Wi-Fi public ou des lieux inconnus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti protegge dall’attività del portafoglio su reti non attendibili, come Wi-Fi pubblici o luoghi sconosciuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公衆Wi-Fiや不明な場所など、信頼できないネットワークでのウォレットのアクティビティから保護します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공용 Wi-Fi나 알 수 없는 위치처럼 신뢰할 수 없는 환경에서 지갑이 활동하지 않도록 보호합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit beschermt je tegen portemonnee-activiteit op niet-vertrouwde netwerken, zoals openbare Wi-Fi of onbekende locaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chroni to przed aktywnością portfela w niezaufanych sieciach, np. publicznym Wi-Fi, lub w nieznanych miejscach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso protege você contra atividade da carteira em redes não confiáveis, como Wi-Fi público, ou em locais desconhecidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te protejează de activitatea portofelului în rețele nesigure, cum ar fi Wi-Fi public sau locații necunoscute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это защищает от активности кошелька в ненадёжной среде, например в общедоступных сетях Wi-Fi или в незнакомых местах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu özellik, sizi herkese açık Wi-Fi veya bilinmeyen konumlar gibi güvenilir olmayan ağlardaki cüzdan etkinliğine karşı korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це захищає від активності гаманця в недовірених мережах (наприклад, загальнодоступних Wi-Fi) або в невідомих місцях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
