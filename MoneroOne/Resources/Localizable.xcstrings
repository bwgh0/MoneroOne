    "Write this down and store it safely. Never share it with anyone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibe sie auf und bewahre sie sicher auf. Teile sie niemals mit anderen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anótala y guárdala en un lugar seguro. Nunca la compartas con nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez-la et conservez-la en lieu sûr. Ne la communiquez jamais à personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascrivila e conservala al sicuro. Non condividerla mai con nessuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き留めて安全に保管してください。絶対に誰とも共有しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 내용을 적어서 안전하게 보관하세요. 누구와도 공유하지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf dit op en bewaar het veilig. Deel het nooit met iemand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz ją i przechowuj bezpiecznie. Nigdy nikomu jej nie udostępniaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote e guarde em local seguro. Nunca compartilhe com ninguém."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noteaz-o și păstreaz-o în siguranță. Nu o partaja niciodată cu nimeni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите её и храните в надёжном месте. Никому её не передавайте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu bir yere yazın ve güvenli bir yerde saklayın. Asla kimseyle paylaşmayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишіть фразу та зберігайте її в надійному місці. Нікому її не показуйте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将其写下并妥善保管。切勿与任何人共享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請將它寫下來並妥善保管。切勿與任何人分享。"
          }
        }
