    "This link uses a payment ID, which Monero no longer supports. Ask the recipient for a subaddress or an integrated address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link nutzt eine Zahlungs-ID, die Monero nicht mehr unterstützt. Bitte den Empfänger um eine Subadresse oder eine integrierte Adresse."
