    "Stored only on the device that originally sent this transaction. Recipients use this key with the transaction ID and destination address to verify the payment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur auf dem Gerät gespeichert, das diese Transaktion gesendet hat. Empfänger prüfen die Zahlung mit diesem Schlüssel, der Transaktions-ID und der Zieladresse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se guarda en el dispositivo que envió originalmente esta transacción. Los destinatarios usan esta clave con el ID de transacción y la dirección de destino para verificar el pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockée uniquement sur l’appareil qui a envoyé cette transaction. Le destinataire utilise cette clé avec l’ID de transaction et l’adresse de destination pour vérifier le paiement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvata solo sul dispositivo che ha inviato questa transazione. I destinatari usano questa chiave con l’ID transazione e l’indirizzo di destinazione per verificare il pagamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このトランザクションを送金したデバイスにのみ保存されます。受取人は、このキーとトランザクションID、送金先アドレスを使って支払いを検証します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 거래를 처음 보낸 기기에만 저장됩니다. 받는 사람은 이 키를 거래 ID 및 받는 주소와 함께 사용하여 결제를 확인합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen bewaard op het apparaat dat deze transactie oorspronkelijk verzond. Ontvangers gebruiken deze sleutel met de transactie-ID en het bestemmingsadres om de betaling te controleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechowywany tylko na urządzeniu, z którego wysłano tę transakcję. Odbiorca używa tego klucza z ID transakcji i adresem docelowym, aby zweryfikować płatność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armazenada apenas no dispositivo que enviou esta transação originalmente. Os destinatários usam esta chave com o ID da transação e o endereço de destino para verificar o pagamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocată doar pe dispozitivul care a trimis inițial această tranzacție. Destinatarii folosesc această cheie împreună cu ID-ul tranzacției și adresa de destinație pentru a verifica plata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранится только на устройстве, с которого была отправлена эта транзакция. Получатель использует этот ключ вместе с ID транзакции и адресом назначения, чтобы проверить платёж."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu işlemi ilk gönderen aygıtta saklanır. Alıcılar ödemeyi doğrulamak için bu anahtarı işlem ID'si ve hedef adresle birlikte kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігається лише на пристрої, з якого надіслано цю транзакцію. Одержувачі використовують цей ключ разом з ID транзакції та адресою призначення, щоб перевірити платіж."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅存储在最初发送此交易的设备上。收款人可结合此密钥、交易 ID 和目标地址来验证付款。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅儲存在最初傳送此交易的裝置上。收款人可結合此金鑰、交易 ID 和目標位址來驗證付款。"
          }
        }
      }
    },
