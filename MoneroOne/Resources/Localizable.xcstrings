    "Your wallet is syncing from an untrusted location. Add this location as trusted in Settings if this is intentional." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wallet synchronisiert an einem nicht vertrauenswürdigen Ort. Füge diesen Ort in den Einstellungen als vertrauenswürdig hinzu, wenn das beabsichtigt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cartera se está sincronizando desde una ubicación no confiable. Si es intencional, agrega esta ubicación como de confianza en Configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre portefeuille se synchronise depuis un lieu non fiable. Si c’est voulu, ajoutez ce lieu comme lieu de confiance dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il portafoglio si sta sincronizzando da un luogo non attendibile. Se è intenzionale, aggiungi questo luogo come attendibile in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォレットが信頼されていない場所で同期しています。意図的な場合は、「設定」でこの場所を信頼できる場所として追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지갑이 신뢰할 수 없는 위치에서 동기화 중입니다. 의도한 것이라면 설정에서 이 위치를 신뢰할 수 있는 위치로 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je portemonnee synchroniseert vanaf een niet-vertrouwde locatie. Voeg deze locatie toe als vertrouwd in Instellingen als dit de bedoeling is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portfel synchronizuje się w niezaufanej lokalizacji. Jeśli to zamierzone, dodaj tę lokalizację jako zaufaną w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
