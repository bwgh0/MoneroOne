    "An accurate date speeds up scanning. Skip to scan from genesis." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein genaues Datum beschleunigt den Scan. Überspringe es, um ab dem Genesis-Block zu scannen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fecha precisa acelera el escaneo. Omite este paso para escanear desde el bloque génesis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une date précise accélère l’analyse. Passez cette étape pour analyser depuis le bloc de genèse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una data precisa velocizza la scansione. Salta per scansionare dal blocco genesi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正確な日付を指定するとスキャンが速くなります。スキップするとジェネシスブロックからスキャンします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정확한 날짜를 입력하면 스캔이 빨라집니다. 건너뛰면 제네시스 블록부터 스캔합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een juiste datum versnelt het scannen. Sla over om vanaf het genesisblok te scannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokładna data przyspiesza skanowanie. Pomiń, aby skanować od pierwszego bloku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma data precisa acelera a varredura. Pule para escanear desde o bloco gênese."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dată exactă accelerează scanarea. Omite pentru a scana de la blocul geneză."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точная дата ускоряет сканирование. Пропустите этот шаг, чтобы сканировать с первого блока."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğru bir tarih taramayı hızlandırır. Başlangıç bloğundan taramak için atlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точна дата пришвидшує сканування. Пропустіть, щоб сканувати з першого блоку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准确的日期可以加快扫描。跳过则从创世区块开始扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準確的日期可加快掃描。略過則從創世區塊開始掃描。"
          }
        }
      }
    },
    "An unknown error occurred. Please check your seed phrase and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein unbekannter Fehler ist aufgetreten. Prüfe deine Seed-Phrase und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se produjo un error desconocido. Revisa tu frase semilla e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur inconnue s’est produite. Vérifiez votre phrase de récupération et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è verificato un errore sconosciuto. Controlla la frase seed e riprova."
