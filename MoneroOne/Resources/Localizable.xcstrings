        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서만 모든 지갑을 제거합니다. 지갑은 블록체인에 그대로 남아 있으며 시드 문구로 복구할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
