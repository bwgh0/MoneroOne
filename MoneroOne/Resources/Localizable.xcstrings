        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze software wordt geleverd in de huidige staat. We streven naar veiligheid en betrouwbaarheid, maar kunnen niet garanderen dat de software vrij is van fouten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To oprogramowanie jest udostępniane w stanie „tak jak jest”. Dbamy o bezpieczeństwo i niezawodność, ale nie możemy zagwarantować, że oprogramowanie jest wolne od błędów."
