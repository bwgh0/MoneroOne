          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portofelul se sincronizează dintr-o locație nesigură. Dacă este intenționat, adaugă această locație ca locație de încredere în Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кошелёк синхронизируется из недоверенного места. Если это сделано намеренно, добавьте это место в доверенные в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
