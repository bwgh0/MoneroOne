    "Share these to set up a view-only wallet — it can watch incoming transactions but cannot spend." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile diese Daten, um eine View-Only-Wallet einzurichten. Sie sieht eingehende Transaktionen, kann aber nichts ausgeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compártelas para configurar una cartera de solo visualización — puede ver las transacciones entrantes, pero no gastar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez-les pour configurer un portefeuille d’audit — il peut suivre les transactions entrantes, mais pas dépenser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi questi dati per configurare un portafoglio solo visualizzazione — può monitorare le transazioni in entrata ma non può spendere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらを共有すると閲覧専用ウォレットを設定できます。閲覧専用ウォレットでは受け取ったトランザクションを確認できますが、送金はできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 정보를 공유하면 보기 전용 지갑을 설정할 수 있습니다 — 들어오는 거래는 볼 수 있지만 지출은 할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deel deze gegevens om een alleen-lezen portemonnee in te stellen — die kan inkomende transacties volgen, maar niets uitgeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnij te dane, aby skonfigurować portfel tylko do podglądu – może on obserwować przychodzące transakcje, ale nie może wydawać środków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe estes dados para configurar uma carteira somente leitura — ela pode acompanhar as transações recebidas, mas não pode gastar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partajează aceste date pentru a configura un portofel de citire — poate urmări tranzacțiile primite, dar nu poate cheltui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поделитесь ими, чтобы настроить кошелёк только для просмотра — он видит входящие транзакции, но не может тратить средства."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca görüntüleme cüzdanı kurmak için bunları paylaşın — bu cüzdan gelen işlemleri izleyebilir ancak harcama yapamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поширте ці дані, щоб налаштувати гаманець лише для перегляду — він бачить вхідні транзакції, але не може витрачати кошти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享这些信息即可设置只读钱包。只读钱包可以查看收到的交易，但无法花费资金。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享這些資訊即可設定唯讀錢包。唯讀錢包可以查看收到的交易，但無法花費資金。"
          }
        }
      }
    },
